generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
  MASTER
}

enum SolicitudEstado {
  PENDIENTE
  EN_REVISION
  APROBADA
  RECHAZADA
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum ShippingStatus {
  PENDING
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum InventoryMovementType {
  CREATED
  ADJUSTMENT
  ORDER_DEDUCTION
}

model Product {
  id                 String              @id @default(cuid())
  slug               String              @unique
  sku                String?             @unique
  oemReference       String?
  alternativeReferences String[]         @default([])
  category           String
  name               String
  brand              String
  price              Int
  previousPrice      Int
  stock              Int                 @default(12)
  minimumStock       Int                 @default(3)
  image              String
  galleryImages      String[]            @default([])
  availability       String
  description        String
  application        String?
  compatibility      String[]            @default([])
  warranty           String?
  technicalSheetUrl  String?
  technicalSpecs     Json?
  featured           Boolean             @default(false)
  active             Boolean             @default(true)
  vendorId           String?
  vendor             User?               @relation("VendorProducts", fields: [vendorId], references: [id])
  inventoryMovements InventoryMovement[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model User {
  id           String   @id @default(cuid())
  fullName     String
  company      String?
  email        String   @unique
  phone        String?
  department   String?
  city         String?
  addressLine1 String?
  addressLine2 String?
  passwordHash String
  role                UserRole            @default(CUSTOMER)
  cartItems           CartItem[]
  orders              Order[]
  products            Product[]           @relation("VendorProducts")
  empresaSolicitudes  EmpresaSolicitud[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  name      String
  price     String
  image     String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
}

model Order {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  shippingStatus ShippingStatus @default(PENDING)
  customerName  String
  customerEmail String
  customerPhone String
  company       String?
  department    String
  city          String
  addressLine1  String
  addressLine2  String?
  notes         String?
  carrier       String?
  trackingNumber String?
  adminNotes    String?
  shippedAt     DateTime?
  deliveredAt   DateTime?
  subtotal      Int
  totalItems    Int
  items         OrderItem[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  name      String
  image     String
  unitPrice Int
  quantity  Int
  lineTotal Int
  createdAt DateTime @default(now())
}

model InventoryMovement {
  id         String                @id @default(cuid())
  productId  String
  product    Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  type       InventoryMovementType
  quantity   Int
  stockAfter Int
  note       String?
  createdAt  DateTime              @default(now())
}

model EmpresaSolicitud {
  id String @id @default(cuid())

  // 1. Datos de la empresa
  nombreEmpresa    String
  razonSocial      String
  nit              String
  tipoEmpresa      String
  pais             String
  ciudad           String
  direccion        String
  telefonoEmpresa  String
  correoEmpresa    String
  paginaWeb        String?

  // 2. Representante legal
  repNombre  String
  repTipoDoc String
  repNumDoc  String
  repCargo   String
  repCelular String
  repCorreo  String

  // 3. Información comercial
  categorias    String[]  @default([])
  subcategorias String?
  descripcion   String
  anosEnMercado String
  vendeOnline   Boolean   @default(false)
  linkTienda    String?
  operaEn       String?

  // 4. Documentos (URLs Supabase Storage)
  urlRut            String?
  urlCamaraComercio String?
  urlDocRepLegal    String?
  urlCertBancaria   String?
  urlLogo           String?
  urlCatalogo       String?

  // 5. Información de productos
  cantidadProductos String
  inventarioPropio  Boolean @default(false)
  preciosMayoristas Boolean @default(false)
  ofreceGarantia    Boolean @default(false)
  tiempoDespacho    String
  coberturaEnvios   String

  // 6. Pagos y facturación
  banco             String
  tipoCuenta        String
  numeroCuenta      String
  titularCuenta     String
  emiteFactura      Boolean @default(false)
  correoFacturacion String

  // Estado y relación
  estado        SolicitudEstado @default(PENDIENTE)
  adminNotes    String?
  calificacion  Int?
  userId        String?
  user       User?           @relation(fields: [userId], references: [id])
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model TallerSolicitud {
  id String @id @default(cuid())

  // Datos del taller
  nombreTaller   String
  tipoTaller     String
  servicios      String[]  @default([])
  descripcion    String?

  // Ubicación
  ciudad         String
  direccion      String
  departamento   String?

  // Contacto
  nombreContacto String
  telefono       String
  whatsapp       String?
  correo         String?
  horario        String?

  // Foto opcional
  urlFoto        String?

  // Estado
  estado         SolicitudEstado @default(PENDIENTE)
  adminNotes     String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}
